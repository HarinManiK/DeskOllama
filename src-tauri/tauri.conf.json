{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskOllama",
  "version": "1.0.0",
  "identifier": "com.deskollama.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeskOllama",
        "width": 1150,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": [33, 33, 33, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
